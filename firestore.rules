rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Internal counter documents — server-only
    match /_counters/{doc} {
      allow read, write: if false;
    }

    // All ERP collections require an authenticated user
    match /crm_leads/{doc} {
      allow read, write: if request.auth != null;
    }

    match /crm_customers/{doc} {
      allow read, write: if request.auth != null;
    }

    match /crm_deals/{doc} {
      allow read, write: if request.auth != null;
    }

    match /crm_activities/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    match /scm_suppliers/{doc} {
      allow read, write: if request.auth != null;
    }

    match /scm_products/{doc} {
      allow read, write: if request.auth != null;
    }

    match /scm_purchase_requests/{doc} {
      allow read, write: if request.auth != null;
    }

    match /scm_stock_movements/{doc} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
