rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // -------------------------------------------------------------------------
    // GLOBALS
    // -------------------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // SUPPLIERS
    // -------------------------------------------------------------------------
    match /suppliers/{supplierId} {
      function isValidSupplier(data) {
        return data.keys().hasAll(['code', 'name', 'email', 'status'])
          && data.code is string && data.code.size() <= 50
          && data.name is string && data.name.size() <= 100
          && data.email is string && data.email.size() <= 100
          && data.status in ['active', 'inactive'];
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(supplierId) && isValidSupplier(incoming());
      allow update: if isSignedIn() && isValidSupplier(incoming());
      allow delete: if isSignedIn(); // In real ERP, maybe only Admin
    }

    // -------------------------------------------------------------------------
    // PRODUCTS
    // -------------------------------------------------------------------------
    match /products/{productId} {
      function isValidProduct(data) {
        return data.keys().hasAll(['sku', 'name', 'category', 'status'])
          && data.sku is string && data.sku.size() <= 50
          && data.name is string && data.name.size() <= 100
          && data.status in ['active', 'discontinued'];
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidId(productId) && isValidProduct(incoming());
      allow update: if isSignedIn() && isValidProduct(incoming());
    }

    // -------------------------------------------------------------------------
    // LEADS & CUSTOMERS
    // -------------------------------------------------------------------------
    match /leads/{leadId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(leadId);
    }

    match /customers/{customerId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(customerId);
    }

    match /deals/{dealId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(dealId);
    }

    // -------------------------------------------------------------------------
    // AUDIT LOGS
    // -------------------------------------------------------------------------
    match /audit_logs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
    }
  }
}
