# ─── App ──────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Firebase Admin SDK (Server) ──────────────────────────────────────────────
# Required: your Firebase project ID
FIREBASE_PROJECT_ID=your-firebase-project-id

# Named Firestore database ID — leave blank to use "(default)"
FIREBASE_DATABASE_ID=your-database-id

# Option A — Service Account (recommended)
# Download from Firebase Console → Project Settings → Service Accounts → Generate new key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option B — Application Default Credentials (ADC)
# Point to your service account JSON file instead of inlining credentials.
# GOOGLE_APPLICATION_CREDENTIALS=./firebase-service-account.json

# ─── Firebase Web Client SDK (Frontend — Vite exposes VITE_ vars) ─────────────
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxx
VITE_FIREBASE_DATABASE_ID=your-database-id

# ─── MySQL / Drizzle ──────────────────────────────────────────────────────────
# Only required if using MySQL features. Firestore is the primary DB for the PoC.
DATABASE_URL=mysql://root:password@localhost:3306/wardsuite
